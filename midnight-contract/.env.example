# Existing Midnight attester configuration
HANDSHAKE_ATTESTER_SECRET_KEY=replace-with-32-byte-hex-jubjub-scalar

# Demo email signer used by the legacy local synthetic-email smoke route
HANDSHAKE_SYNTHETIC_DKIM_PRIVATE_KEY=base64-encoded-pem-private-key

# Demo receipt token secret. Must match the root app's RESEND_DEMO_RECEIPT_SECRET.
RESEND_DEMO_RECEIPT_SECRET=replace-with-the-same-random-secret-configured-in-the-frontend

# Must match the Gmail account configured for sending demo receipts in the root app.
HANDSHAKE_DEMO_RECEIPT_FROM=your-sender@gmail.com

# Standalone online attestor. Use exact frontend origins, or * to allow all origins.
HANDSHAKE_ATTESTER_HOST=0.0.0.0
PORT=8787
HANDSHAKE_ATTESTER_ALLOWED_ORIGINS=https://your-frontend.example
HANDSHAKE_ATTESTER_RATE_LIMIT_PER_MINUTE=20
