{
  "name": "midnight-contract",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-mn-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/hello-world.compact contracts/managed/hello-world",
    "compile:market": "compact compile contracts/handshake-market.compact contracts/managed/handshake-market",
    "compile:demo-token": "compact compile contracts/handshake-demo-usdc.compact contracts/managed/handshake-demo-usdc",
    "compile:all": "npm run compile:demo-token && npm run compile:market",
    "test": "node --test",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "attester:keygen": "npx tsx src/attester-keygen.ts",
    "dkim:keygen": "npx tsx src/synthetic-dkim-keygen.ts",
    "demo:email": "npx tsx src/synthetic-email-demo.ts",
    "attester:start": "npx tsx src/attester-server.ts",
    "market:smoke": "npx tsx src/market-smoke.ts",
    "market:payment-smoke": "npx tsx src/market-payment-smoke.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "2.2.0",
    "@types/mailparser": "^3.9.0",
    "mailauth": "^7.3.0",
    "mailparser": "^3.9.40",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
