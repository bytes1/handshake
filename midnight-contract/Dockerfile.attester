FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

COPY src ./src
COPY contracts/managed/handshake-market/contract/index.js ./contracts/managed/handshake-market/contract/index.js

ENV HANDSHAKE_ATTESTER_HOST=0.0.0.0
EXPOSE 8787
USER node
CMD ["npm", "run", "attester:start"]
