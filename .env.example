

# Gmail sends a conspicuously labeled demo receipt. This is not a payment confirmation.
GMAIL_EMAIL=your-sender@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password
RESEND_DEMO_RECEIPT_SECRET=replace-with-the-same-random-secret-configured-in-the-attestor

# Handshake Preview deployment. Override the network/address together when switching networks.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preview
NEXT_PUBLIC_MARKET_CONTRACT_ADDRESS=5bc81b4a60166225d0063d189190e347f65c567b1f6e9717095bed9acb057894
NEXT_PUBLIC_DEMO_TOKEN_ADDRESS=6feb3cc3d2d9f4d2c9f27332757adb898354b5d3a10376f75d66d299689ec82f
NEXT_PUBLIC_DEMO_TOKEN_DOMAIN_HEX=aff26d3a51388c32b94a8fe2cda8ed082ce644e07becaab28eb9486072e57082
# Local proof server used to generate the buyer's Midnight proof for the Preview contract.
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# Set this to the deployed HTTPS attestor URL before building the frontend.
# NEXT_PUBLIC_ATTESTER_URL=http://127.0.0.1:8787
NEXT_PUBLIC_ATTESTER_URL=https://handshake-attestor.onrender.com
